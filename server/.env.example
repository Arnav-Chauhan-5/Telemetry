# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/telemetry

# Secret used to sign JSON Web Tokens — change this to something random!
JWT_SECRET=change-me-to-a-random-secret

# Redis connection URL (used by BullMQ for job scheduling)
REDIS_URL=redis://localhost:6379

# SMTP configuration for email notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
NOTIFY_EMAIL_FROM=noreply@telemetry.local
